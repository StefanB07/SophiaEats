          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant\": \"Restaurant A\",\n  \"dish\": \"Pizza Margherita\",\n  \"qty\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items",
          "host": [
